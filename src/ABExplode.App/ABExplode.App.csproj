<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI em Avalonia. Dois alvos: net10.0-windows usa Platform.Windows, net10.0 usa Platform.Linux.
       Publicar: -f net10.0-windows -r win-x64  |  -f net10.0 -r linux-x64 (publicar.bat e publicar.yml).
       É o app publicado (ABExplode.exe); o WPF da raiz fica só como referência até a Fase 5 do MIGRACAO-AVALONIA.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <RootNamespace>ABExplode.App</RootNamespace>
    <!-- Mesmo nome do executável de antes; os recursos ficam em avares://ABExplode/ -->
    <AssemblyName>ABExplode</AssemblyName>
    <ApplicationIcon>..\..\Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!-- Administrador só no Windows: necessário para MSRs, Super I/O e outros sensores de baixo nível. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\Assets\app.ico" Link="Assets\app.ico" />
    <AvaloniaResource Include="..\..\Assets\logo.png" Link="Assets\logo.png" />
    <AvaloniaResource Include="..\..\Assets\logo-dark.png" Link="Assets\logo-dark.png" />
    <AvaloniaResource Include="..\..\Assets\logo-badge.png" Link="Assets\logo-badge.png" />
    <AvaloniaResource Include="..\..\Assets\Fonts\FluentSystemIcons-Regular.ttf" Link="Assets\Fonts\FluentSystemIcons-Regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ABExplode.Core\ABExplode.Core.csproj" />
    <ProjectReference Include="..\ABExplode.Platform\ABExplode.Platform.csproj" />
  </ItemGroup>

  <!-- Os pacotes nativos do Skia e do HarfBuzz trazem .pdb (100 MB) que o DebugType=None não tira da publicação. -->
  <Target Name="DropNativePdbs" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- iCUE SDK da Corsair (RESET INTEGRAÇÃO): se a DLL estiver em Native\, ela vai junto do .exe. Não é versionada no git. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <None Include="..\..\Native\iCUESDK.x64_2019.dll" Condition="Exists('..\..\Native\iCUESDK.x64_2019.dll')" Link="iCUESDK.x64_2019.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\ABExplode.Platform.Windows\ABExplode.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <ProjectReference Include="..\ABExplode.Platform.Linux\ABExplode.Platform.Linux.csproj" />
  </ItemGroup>

</Project>
