<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ABExplode.App.ToastWindow"
        Title="ABExplode aviso" WindowDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" CanResize="False" Focusable="False"
        SizeToContent="WidthAndHeight" Opacity="0">
    <!-- Sempre escuro: aparece por cima de jogos e da área de trabalho -->
    <Window.Transitions>
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
        </Transitions>
    </Window.Transitions>
    <Border Background="#F2080808" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="4" Padding="16,12" Width="340">
        <Grid ColumnDefinitions="Auto,*">
            <Border Width="34" Height="34" Background="#F5F5F5" CornerRadius="3" VerticalAlignment="Top" Margin="0,2,14,0">
                <TextBlock Name="TIcon" Text="&#xE88E;" FontFamily="{StaticResource Icons}" FontSize="17"
                           Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Name="TTitle" Foreground="#F5F5F5" FontFamily="{StaticResource UiFont}" FontSize="13.5"
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Name="TText" Foreground="#9A9A9A" FontFamily="{StaticResource UiFont}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                <TextBlock Text="ABExplode" Foreground="#4A4A4A" FontSize="9.5" FontWeight="Bold" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
