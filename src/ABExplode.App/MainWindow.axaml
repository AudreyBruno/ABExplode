<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ABExplode.Core;assembly=ABExplode.Core"
        xmlns:plat="clr-namespace:ABExplode.Platform;assembly=ABExplode.Platform"
        xmlns:local="clr-namespace:ABExplode.App"
        x:Class="ABExplode.App.MainWindow"
        Title="ABExplode" Icon="avares://ABExplode.App/Assets/app.ico"
        Width="1320" Height="840" MinWidth="1120" MinHeight="660" WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="44" WindowDecorations="BorderOnly"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="13">

    <Window.Resources>
        <local:UsedArcConverter x:Key="UsedArc"/>
    </Window.Resources>

    <Window.DataTemplates>
        <!-- Linha da tela "Sistema": folha = chave/valor; grupo = título + filhos (recursivo) -->
        <DataTemplate DataType="core:InfoNode" x:DataType="core:InfoNode">
            <StackPanel>
                <Border IsVisible="{Binding !IsGroup}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                    <Grid ColumnDefinitions="260,*">
                        <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <StackPanel IsVisible="{Binding IsGroup}" Margin="0,26,0,0">
                    <TextBlock Text="{Binding Header}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding Children}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.DataTemplates>

    <Border Name="Root" BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid RowDefinitions="44,*" ColumnDefinitions="256,*">

            <!-- ===== Barra de título: arrastar a janela, marca, página atual e botões ===== -->
            <Border Grid.ColumnSpan="2" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar"
                    DoubleTapped="TitleBar_DoubleTapped"/>
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Margin="30,0,0,0" HorizontalAlignment="Left"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Name="TitleLogo" Source="avares://ABExplode.App/Assets/logo.png" Width="22" Height="22" Margin="0,0,12,0"
                       VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <TextBlock Text="AB" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Text="EXPLODE" FontWeight="Light" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock Name="TitlePage" Foreground="{DynamicResource Faint}" FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="BtnTheme" Theme="{StaticResource CaptionButton}" AutomationProperties.Name="Tema" Content="&#xE706;" Click="Theme_Click" ToolTip.Tip="Modo claro"/>
                <Button Theme="{StaticResource CaptionButton}" Content="&#xE921;" AutomationProperties.Name="Minimizar" Click="Min_Click" ToolTip.Tip="Minimizar"/>
                <Button Name="BtnMax" Theme="{StaticResource CaptionButton}" AutomationProperties.Name="Maximizar" Content="&#xE922;" Click="Max_Click" ToolTip.Tip="Maximizar"/>
                <Button Theme="{StaticResource CloseButton}" AutomationProperties.Name="Fechar" Content="&#xE8BB;" Click="Close_Click" ToolTip.Tip="Fechar"/>
            </StackPanel>

            <!-- ===== Menu lateral por categorias ===== -->
            <Border Name="Sidebar" Grid.Row="1" Margin="14,0,0,14" Background="{DynamicResource Panel}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20">
                <DockPanel>
                    <!-- Rodapé: aviso de sensores + leitura ao vivo compacta -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,6,16,16">
                        <Border Name="CpuSensorWarn" IsVisible="False" BorderBrush="{DynamicResource Fg}" BorderThickness="1"
                                CornerRadius="12" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Sem temperatura e consumo da CPU" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Name="CpuSensorWarnText" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                <Button Theme="{StaticResource PrimaryButton}" Content="CORRIGIR" Padding="10,5" FontSize="11"
                                        Click="BtnFixCpuSensors_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" Padding="14,10">
                            <Grid ColumnDefinitions="46,*,Auto" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="CPU" Foreground="{DynamicResource Faint}" FontSize="10.5" FontWeight="Bold" Margin="0,3" VerticalAlignment="Center"/>
                                <TextBlock Name="SideTemp" Grid.Column="1" Text="—" Classes="mono" FontSize="12" Margin="0,3"/>
                                <TextBlock Name="SideLoad" Grid.Column="2" Text="—" Classes="mono" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3"/>
                                <TextBlock Grid.Row="1" Text="GPU" Foreground="{DynamicResource Faint}" FontSize="10.5" FontWeight="Bold" Margin="0,3" VerticalAlignment="Center"/>
                                <TextBlock Name="SideGpuTemp" Grid.Row="1" Grid.Column="1" Text="—" Classes="mono" FontSize="12" Margin="0,3"/>
                                <TextBlock Name="SideGpuLoad" Grid.Row="1" Grid.Column="2" Text="—" Classes="mono" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3"/>
                                <TextBlock Grid.Row="2" Text="TESTE" Foreground="{DynamicResource Faint}" FontSize="10.5" FontWeight="Bold" Margin="0,3" VerticalAlignment="Center"/>
                                <TextBlock Name="SideStress" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="parado" Classes="mono" FontSize="12" Margin="0,3"/>
                            </Grid>
                        </Border>
                        <TextBlock Name="SideVersion" Text="v0.16" Foreground="{DynamicResource Faint}" FontSize="11" Margin="4,10,0,0"/>
                    </StackPanel>

                    <!-- Navegação por categorias (Tag = página; o grupo da categoria é o ToggleButton logo acima) -->
                    <ScrollViewer Name="NavScroll" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                        <StackPanel Margin="0,0,0,10">
                            <RadioButton Name="NavDash" Theme="{StaticResource NavItem}" Tag="PageDash" AutomationProperties.Name="Visão geral" IsCheckedChanged="Nav_Checked">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Visão geral" VerticalAlignment="Center"/></StackPanel>
                            </RadioButton>

                            <ToggleButton Name="GrpExplode" Theme="{StaticResource NavGroup}" Content="ABExplode"/>
                            <StackPanel Name="GrpExplodeItems" Margin="10,0,0,4" IsVisible="{Binding #GrpExplode.IsChecked}">
                                <RadioButton Name="NavSystem" Theme="{StaticResource NavItem}" Tag="PageSystem" AutomationProperties.Name="Sistema" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F8;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Sistema" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Name="NavSensors" Theme="{StaticResource NavItem}" Tag="PageSensors" AutomationProperties.Name="Sensores" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Sensores" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Name="NavGpu" Theme="{StaticResource NavItem}" Tag="PageGpu" AutomationProperties.Name="Placa de vídeo" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Placa de vídeo" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Name="NavDisks" Theme="{StaticResource NavItem}" Tag="PageDisks" AutomationProperties.Name="Discos" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Discos" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Name="NavEnergy" Theme="{StaticResource NavItem}" Tag="PageEnergy" AutomationProperties.Name="Energia" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Energia" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Name="NavNet" Theme="{StaticResource NavItem}" Tag="PageNet" AutomationProperties.Name="Rede" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE839;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Rede" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <ToggleButton Name="GrpGames" Theme="{StaticResource NavGroup}" Content="RESET JOGOS"/>
                            <StackPanel Name="GrpGamesItems" Margin="10,0,0,4" IsVisible="{Binding #GrpGames.IsChecked}">
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageLauncher" AutomationProperties.Name="Biblioteca" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Biblioteca" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageGames" AutomationProperties.Name="FPS estimado" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC49;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="FPS estimado" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageBottleneck" AutomationProperties.Name="Gargalo" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Gargalo" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageOverlay" AutomationProperties.Name="Overlay" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81E;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Overlay" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <ToggleButton Name="GrpPerf" Theme="{StaticResource NavGroup}" Content="RESET DESEMPENHO"/>
                            <StackPanel Name="GrpPerfItems" Margin="10,0,0,4" IsVisible="{Binding #GrpPerf.IsChecked}">
                                <RadioButton Name="NavBench" Theme="{StaticResource NavItem}" Tag="PageBench" AutomationProperties.Name="Benchmark" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B9;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Benchmark" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageStress" AutomationProperties.Name="Stress test" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Stress test" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageOc" AutomationProperties.Name="Overclock" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC4A;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Overclock" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <ToggleButton Name="GrpTools" Theme="{StaticResource NavGroup}" Content="RESET FERRAMENTAS"/>
                            <StackPanel Name="GrpToolsItems" Margin="10,0,0,4" IsVisible="{Binding #GrpTools.IsChecked}">
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageOptimize" AutomationProperties.Name="Otimização" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F3;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Otimização" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageStartup" AutomationProperties.Name="Inicialização" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Inicialização" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageApps" AutomationProperties.Name="Instalar apps" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE719;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Instalar apps" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageDriver" AutomationProperties.Name="Drivers" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Drivers" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageInteg" AutomationProperties.Name="Integração" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Integração" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <ToggleButton Name="GrpMaker" Theme="{StaticResource NavGroup}" Content="RESET MAKER"/>
                            <StackPanel Name="GrpMakerItems" Margin="10,0,0,4" IsVisible="{Binding #GrpMaker.IsChecked}">
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageMakerPorts" AutomationProperties.Name="Portas COM" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE88E;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Portas COM" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                                <RadioButton Theme="{StaticResource NavItem}" Tag="PageMakerDrv" AutomationProperties.Name="Drivers seriais" IsCheckedChanged="Nav_Checked">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE950;" Classes="icon" FontSize="14" Width="28" VerticalAlignment="Center"/><TextBlock Text="Drivers seriais" VerticalAlignment="Center"/></StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Conteúdo ===== -->
            <Panel Name="Pages" Grid.Row="1" Grid.Column="1">

                <!-- ===== Telas que ainda estão só no app WPF ===== -->
                <StackPanel Name="PageTodo" Margin="36,30,36,30" IsVisible="False">
                    <TextBlock Name="TodoTitle" Classes="h1"/>
                    <TextBlock Classes="sub" TextWrapping="Wrap"
                               Text="Esta tela ainda não foi migrada para a nova interface. Por enquanto, use o ABExplode de sempre (WPF)."/>
                </StackPanel>

                <!-- ===== VISÃO GERAL (painel) ===== -->
                <ScrollViewer Name="PageDash" VerticalScrollBarVisibility="Auto" IsVisible="False">
                    <StackPanel Margin="20,6,24,20">

                        <!-- Linha 1: gráfico grande + desempenho -->
                        <Grid ColumnDefinitions="*,16,330" Margin="0,0,0,16">
                            <Border Classes="card" Padding="24,20">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Name="DashChartLabel" Text="CPU · TEMPERATURA" Classes="label" Margin="0,0,0,4"/>
                                            <TextBlock Name="DashChartDelta" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                            <TextBlock Name="DashChartValue" Text="—" Classes="hero mono" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                            <TextBlock Text="GPU" Classes="label" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                            <TextBlock Name="DashChartValue2" Text="—" Classes="mono" FontSize="22"
                                                       Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,16,0,8">
                                        <StackPanel Name="DashRangePanel" Orientation="Horizontal">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="DashRange" Content="1 MIN" Tag="60" IsCheckedChanged="DashOption_Checked"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="DashRange" Content="5 MIN" Tag="300" IsChecked="True" IsCheckedChanged="DashOption_Checked"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="DashRange" Content="15 MIN" Tag="900" IsCheckedChanged="DashOption_Checked"/>
                                        </StackPanel>
                                        <StackPanel Name="DashMetricPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="DashMetric" Content="Temperatura" Tag="temp" IsChecked="True" IsCheckedChanged="DashOption_Checked"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="DashMetric" Content="Carga" Tag="load" IsCheckedChanged="DashOption_Checked"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="DashMetric" Content="Consumo" Tag="power" IsCheckedChanged="DashOption_Checked"/>
                                        </StackPanel>
                                    </Grid>
                                    <Canvas Name="DashChart" Height="210" ClipToBounds="True" SizeChanged="DashChart_SizeChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Rectangle Width="14" Height="2" Fill="{DynamicResource Fg}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="CPU" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                                        <Line StartPoint="0,0" EndPoint="14,0" Stroke="{DynamicResource Muted}" StrokeDashArray="3,2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="GPU" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Desempenho -->
                            <Border Grid.Column="2" Classes="card" Padding="22,20">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Theme="{StaticResource PrimaryButton}" Content="RODAR BENCHMARK" Margin="0,14,0,0"
                                            Padding="20,13" HorizontalAlignment="Stretch" Click="DashBench_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="DESEMPENHO · RESET BENCH" Classes="label" Margin="0,0,0,4"/>
                                        <Grid>
                                            <TextBlock Name="DashScore" Text="—" Classes="hero mono"/>
                                            <TextBlock Name="DashScoreDelta" Foreground="{DynamicResource Muted}" FontSize="12"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Name="DashScoreSub" Text="multi-core · nenhum teste ainda" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,0"/>
                                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,16"/>
                                        <ItemsControl Name="DashScores" ItemTemplate="{StaticResource KeyValueRow}"/>
                                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"
                                                Padding="14,4" Margin="0,14,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,10">
                                                    <TextBlock Text="CPU" Foreground="{DynamicResource Muted}"/>
                                                    <TextBlock Name="DashCpuName" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="50,0,0,0"/>
                                                </Grid>
                                                <Border Height="1" Background="{DynamicResource Line}"/>
                                                <Grid Margin="0,10">
                                                    <TextBlock Text="GPU" Foreground="{DynamicResource Muted}"/>
                                                    <TextBlock Name="DashGpuName" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="50,0,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <!-- Linha 2: tabela de componentes -->
                        <Border Classes="card" Padding="22,14,22,8" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid ColumnDefinitions="2.2*,*,*,*,*,56" Margin="0,4,0,10">
                                    <TextBlock Text="COMPONENTE" Classes="label" Margin="0"/>
                                    <TextBlock Grid.Column="1" Text="TEMPERATURA" Classes="label" Margin="0"/>
                                    <TextBlock Grid.Column="2" Text="CARGA" Classes="label" Margin="0"/>
                                    <TextBlock Grid.Column="3" Text="CLOCK" Classes="label" Margin="0"/>
                                    <TextBlock Grid.Column="4" Text="CONSUMO / USO" Classes="label" Margin="0"/>
                                    <TextBlock Grid.Column="5" Text="VER" Classes="label" Margin="0" HorizontalAlignment="Right"/>
                                </Grid>
                                <ItemsControl Name="DashComponents">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:DashComponent">
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,11">
                                                <Grid ColumnDefinitions="2.2*,*,*,*,*,56">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Hover}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Icon}" Classes="icon" FontSize="13"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                            <TextBlock Text="{Binding Model}" Foreground="{DynamicResource Faint}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Temp}" Classes="mono" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Load}" Classes="mono" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Clock}" Classes="mono" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Power}" Classes="mono" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="5" Theme="{StaticResource CaptionButton}" Width="30" Height="30" Content="&#xE72A;"
                                                            HorizontalAlignment="Right" Tag="{Binding Target}" Click="DashGo_Click" ToolTip.Tip="Abrir detalhes"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Linha 3: anéis de memória, eventos e saúde -->
                        <Grid ColumnDefinitions="*,16,*,16,*">
                            <Border Classes="card" Padding="22,20">
                                <StackPanel>
                                    <TextBlock Text="MEMÓRIA E DISCO" Classes="label" Margin="0,0,0,4"/>
                                    <TextBlock Name="DashMemHero" Text="—" Classes="hero mono" FontSize="28"/>
                                    <TextBlock Name="DashMemSub" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,8"/>
                                    <Canvas Name="DashRings" Width="190" Height="190" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                    <ItemsControl Name="DashRingLegend">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:DashRingItem">
                                                <Grid Margin="0,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="8" Height="8" Fill="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Value}" Classes="mono" FontSize="12" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Eventos recentes -->
                            <Border Grid.Column="2" Classes="card" Padding="22,20">
                                <StackPanel>
                                    <TextBlock Text="Eventos recentes" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock Name="DashEventsEmpty" Text="Nada ainda. Benchmarks, testes e dispositivos conectados aparecem aqui."
                                               Foreground="{DynamicResource Faint}" TextWrapping="Wrap" FontSize="12"/>
                                    <ItemsControl Name="DashEvents">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:DashEvent">
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,12">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Fg}" Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Icon}" Classes="icon" FontSize="14" Foreground="{DynamicResource Ink}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Value}" Classes="mono" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                            <TextBlock Text="{Binding When}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Saúde do PC: lista de verificação + ação -->
                            <Border Grid.Column="4" Classes="card" Padding="22,20">
                                <DockPanel>
                                    <Button DockPanel.Dock="Bottom" Theme="{StaticResource PrimaryButton}" Content="RESET OTIMIZA" Padding="20,13"
                                            Margin="0,14,0,0" HorizontalAlignment="Stretch" Click="DashOptimize_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Saúde do PC" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <ItemsControl Name="DashHealth">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:DashCheck">
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,11">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <TextBlock Text="{Binding Glyph}" Classes="icon check" Classes.ok="{Binding Ok}" FontSize="18"
                                                                       Margin="0,0,12,0" VerticalAlignment="Top"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== RESET JOGOS · Biblioteca ===== -->
                <Grid Name="PageLauncher" Margin="36,30,36,30" ColumnDefinitions="320,24,*" IsVisible="False">
                    <!-- Lista de jogos -->
                    <Grid RowDefinitions="Auto,Auto,*">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="RESET JOGOS" Classes="h1"/>
                            <TextBlock Name="LGameCount" Text="Procurando seus jogos…" Classes="sub" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBox Name="LGameSearch" PlaceholderText="Buscar jogo…" TextChanged="LGameSearch_Changed" Margin="0,0,0,8"/>
                            <WrapPanel>
                                <Button Name="BtnScanGames" Theme="{StaticResource OutlineButton}" Content="ATUALIZAR LISTA" Padding="14,8" Margin="0,0,8,0" Click="BtnScanGames_Click"/>
                                <Button Theme="{StaticResource OutlineButton}" Content="+ ADICIONAR .EXE" Padding="14,8" Click="BtnAddExe_Click"/>
                            </WrapPanel>
                        </StackPanel>
                        <ListBox Name="LGameList" Grid.Row="2" ItemContainerTheme="{StaticResource ListNavItem}" Background="Transparent"
                                 SelectionChanged="LGameList_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="plat:LibGame">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.6"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Detalhes do jogo -->
                    <TextBlock Name="LEmpty" Grid.Column="2" Text="Escolha um jogo na lista." Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="0,60,0,0"/>
                    <ScrollViewer Name="LDetail" Grid.Column="2" IsVisible="False" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <Grid Margin="0,0,0,6">
                                <StackPanel Margin="0,0,200,0">
                                    <TextBlock Name="LTitle" Classes="h1" TextWrapping="Wrap"/>
                                    <TextBlock Name="LSub" Classes="sub" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Name="BtnPlay" Theme="{StaticResource PrimaryButton}" Content="JOGAR" Padding="40,14" FontSize="16"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnPlay_Click"/>
                            </Grid>
                            <TextBlock Name="LStatus" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <!-- Desempenho -->
                            <Border Classes="card" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="DESEMPENHO" Classes="label"/>
                                    <TextBlock Text="Prioridade do processo" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                                    <WrapPanel Name="LPriorityPanel" Margin="0,4,0,10">
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LPriority" Content="Normal" Tag="normal" IsChecked="True" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LPriority" Content="Acima do normal" Tag="above" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LPriority" Content="Alta" Tag="high" IsCheckedChanged="LProfile_Changed"/>
                                    </WrapPanel>
                                    <CheckBox Name="LChkPlan" Content="Plano de energia Alto desempenho enquanto joga (volta ao normal depois)" Margin="0,0,0,10" Click="LProfile_Changed"/>
                                    <CheckBox Name="LChkGpu" Content="Forçar a placa de vídeo dedicada (configuração gráfica do Windows)" Margin="0,0,0,10" Click="LProfile_Changed"/>
                                    <CheckBox Name="LChkFso" Content="Desativar otimizações de tela cheia do Windows" Margin="0,0,0,12" Click="LProfile_Changed"/>
                                    <TextBlock Name="LExeText" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Theme="{StaticResource OutlineButton}" Content="ESCOLHER O .EXE" Padding="14,8" Margin="0,0,8,0" Click="BtnPickExe_Click"/>
                                        <Button Theme="{StaticResource OutlineButton}" Content="PERFIL PARA MAIS FPS" Padding="14,8" Click="BtnRecommended_Click"/>
                                    </WrapPanel>
                                    <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Prioridade e plano de energia valem só durante o jogo. As opções de GPU e tela cheia são gravadas para o .exe do jogo no Windows (o programa descobre o .exe sozinho; se errar, escolha o certo)."/>
                                </StackPanel>
                            </Border>

                            <!-- Gráficos -->
                            <Border Classes="card" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="GRÁFICOS (ARGUMENTOS DE INICIALIZAÇÃO)" Classes="label"/>
                                    <TextBlock Text="Modo de janela" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                                    <WrapPanel Name="LModePanel" Margin="0,4,0,10">
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LMode" Content="Padrão do jogo" Tag="default" IsChecked="True" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LMode" Content="Tela cheia" Tag="full" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LMode" Content="Sem bordas" Tag="borderless" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LMode" Content="Janela" Tag="window" IsCheckedChanged="LProfile_Changed"/>
                                    </WrapPanel>
                                    <TextBlock Text="Resolução" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <WrapPanel Name="LResPanel" Margin="0,4,0,10">
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LRes" Content="Padrão" Tag="default" IsChecked="True" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LRes" Content="1280x720" Tag="1280x720" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LRes" Content="1920x1080" Tag="1920x1080" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LRes" Content="2560x1440" Tag="2560x1440" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LRes" Content="3840x2160" Tag="3840x2160" IsCheckedChanged="LProfile_Changed"/>
                                    </WrapPanel>
                                    <TextBlock Text="Taxa de atualização (Hz)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <WrapPanel Name="LHzPanel" Margin="0,4,0,10">
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LHz" Content="Padrão" Tag="0" IsChecked="True" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LHz" Content="60" Tag="60" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LHz" Content="120" Tag="120" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LHz" Content="144" Tag="144" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LHz" Content="165" Tag="165" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LHz" Content="240" Tag="240" IsCheckedChanged="LProfile_Changed"/>
                                    </WrapPanel>
                                    <TextBlock Text="Tipo de argumento (depende do jogo)" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <WrapPanel Name="LStylePanel" Margin="0,4,0,10">
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LStyle" Content="Source / CS2" Tag="source" IsChecked="True" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LStyle" Content="Unity" Tag="unity" IsCheckedChanged="LProfile_Changed"/>
                                        <RadioButton Theme="{StaticResource Chip}" GroupName="LStyle" Content="Unreal" Tag="unreal" IsCheckedChanged="LProfile_Changed"/>
                                    </WrapPanel>
                                    <TextBlock Text="Extras" Foreground="{DynamicResource Muted}" FontSize="12"/>
                                    <TextBox Name="LExtra" PlaceholderText="ex.: -novid -high +fps_max 0" Margin="0,4,0,8" TextChanged="LExtra_Changed"/>
                                    <WrapPanel Name="LExtraPresets" Margin="0,0,0,12"/>
                                    <TextBlock Text="LINHA FINAL" Classes="label"/>
                                    <TextBlock Name="LPreview" Classes="mono" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                    <StackPanel Name="LSteamBox" IsVisible="False">
                                        <TextBlock Name="LSteamNow" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Button Name="BtnSteamApply" Theme="{StaticResource PrimaryButton}" Content="APLICAR NAS OPÇÕES DA STEAM"
                                                HorizontalAlignment="Left" Padding="20,9" Click="BtnSteamApply_Click"/>
                                    </StackPanel>
                                    <TextBlock Name="LGfxNote" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Programas auxiliares -->
                            <Border Classes="card" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="PROGRAMAS AUXILIARES" Classes="label"/>
                                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10"
                                               Text="Ferramentas de terceiros que abrem antes do jogo (monitoramento, comandos, mixer de áudio, script...). O RESET JOGOS as abre sozinho ao clicar em JOGAR e pode fechá-las junto com o jogo. Nada é escrito nas opções da Steam."/>
                                    <ItemsControl Name="LHelpers">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="plat:HelperProgram">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                                                    <Button Grid.Column="1" Theme="{StaticResource OutlineButton}" Content="REMOVER" Padding="10,4" FontSize="11" Tag="{Binding}"
                                                            Click="BtnRemoveHelper_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <WrapPanel Margin="0,6,0,0">
                                        <Button Theme="{StaticResource OutlineButton}" Content="+ ADICIONAR PROGRAMA" Padding="14,8" Margin="0,0,14,0" Click="BtnAddHelper_Click"/>
                                        <CheckBox Name="LHelperClose" Content="Fechar junto com o jogo" IsChecked="True" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ===== RESET JOGOS · FPS estimado ===== -->
                <Grid Name="PageGames" Margin="36,30,36,30" RowDefinitions="Auto,Auto,Auto,*" IsVisible="False">
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Jogos" Classes="h1"/>
                            <TextBlock Name="GamesSub" Text="FPS esperado no seu PC" Classes="sub"/>
                        </StackPanel>
                        <TextBox Name="GameSearch" Width="260" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 PlaceholderText="Buscar jogo…" TextChanged="GameSearch_Changed"/>
                    </Grid>

                    <!-- Configuração -->
                    <Border Grid.Row="1" Classes="card" Margin="0,0,0,14">
                        <WrapPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="RESOLUÇÃO" Classes="label"/>
                                <StackPanel Name="GameResPanel" Orientation="Horizontal">
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GameRes" Content="1080p" Tag="1920x1080" IsChecked="True" IsCheckedChanged="GameOption_Changed"/>
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GameRes" Content="1440p" Tag="2560x1440" IsCheckedChanged="GameOption_Changed"/>
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GameRes" Content="4K" Tag="3840x2160" IsCheckedChanged="GameOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="GRÁFICOS" Classes="label"/>
                                <StackPanel Name="GamePresetPanel" Orientation="Horizontal">
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GamePreset" Content="Baixo" Tag="Baixo" IsCheckedChanged="GameOption_Changed"/>
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GamePreset" Content="Médio" Tag="Médio" IsCheckedChanged="GameOption_Changed"/>
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GamePreset" Content="Alto" Tag="Alto" IsChecked="True" IsCheckedChanged="GameOption_Changed"/>
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GamePreset" Content="Ultra" Tag="Ultra" IsCheckedChanged="GameOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="UPSCALING (DLSS / FSR)" Classes="label"/>
                                <StackPanel Name="GameUpscalePanel" Orientation="Horizontal">
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GameUp" Content="Nativo" Tag="Native" IsChecked="True" IsCheckedChanged="GameOption_Changed"/>
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GameUp" Content="Qualidade" Tag="Quality" IsCheckedChanged="GameOption_Changed"/>
                                    <RadioButton Theme="{StaticResource Chip}" GroupName="GameUp" Content="Desempenho" Tag="Performance" IsCheckedChanged="GameOption_Changed"/>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!-- Fonte dos dados -->
                    <Border Grid.Row="2" Classes="card" Margin="0,0,0,14" Padding="18,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Name="GameSourceTitle" FontWeight="SemiBold"/>
                                <TextBlock Name="GameSourceText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBox Name="ApiKeyBox" Width="240" Margin="0,0,8,0" PasswordChar="●" RevealPassword="False"
                                         PlaceholderText="Chave da API HowManyFPS" ToolTip.Tip="Chave da API HowManyFPS"/>
                                <Button Name="BtnApiKey" Theme="{StaticResource OutlineButton}" Content="SALVAR CHAVE" Padding="16,8" Click="BtnApiKey_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cartões dos jogos -->
                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl Name="GameList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:GameRow">
                                    <Border Classes="card" Margin="0,0,10,10" Padding="16,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Genre}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,2,0,10"/>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FpsText}" Classes="mono" FontSize="30"/>
                                                    <TextBlock Text=" FPS" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Rating}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Muted}"/>
                                            </Grid>
                                            <!-- Barra: escala até 240 FPS -->
                                            <ProgressBar Classes="bar" Margin="0,8,0,8" Value="{Binding Bar}"/>
                                            <Grid>
                                                <TextBlock Text="{Binding LowText}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                <TextBlock Text="{Binding Source}" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- ===== GARGALO ===== -->
                <ScrollViewer Name="PageBottleneck" IsVisible="False" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Detector de gargalo" Classes="h1"/>
                            <TextBlock Text="Descobre o que está limitando o seu FPS: GPU, CPU, memória ou temperatura" Classes="sub"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,14,*" Margin="0,0,0,14">
                            <!-- Equilíbrio teórico -->
                            <Border Classes="card">
                                <StackPanel>
                                    <TextBlock Text="EQUILÍBRIO DO HARDWARE" Classes="label"/>
                                    <Grid Margin="0,4,0,0">
                                        <TextBlock Name="BnCpuName" Foreground="{DynamicResource Muted}"/>
                                        <TextBlock Name="BnGpuName" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <!-- Escala: esquerda = GPU fraca para a CPU; centro = equilibrado; direita = CPU fraca para a GPU -->
                                    <Panel Height="22" Margin="0,8,0,4">
                                        <Border Height="4" Background="{DynamicResource Line}" VerticalAlignment="Center"/>
                                        <Border Width="2" Height="10" Background="{DynamicResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Canvas Name="BnBalanceCanvas" SizeChanged="BnBalanceCanvas_SizeChanged">
                                            <Ellipse Name="BnBalanceDot" Width="14" Height="14" Fill="{DynamicResource Fg}" Canvas.Top="4"/>
                                        </Canvas>
                                    </Panel>
                                    <Grid>
                                        <TextBlock Text="limita a GPU" Foreground="{DynamicResource Faint}" FontSize="11"/>
                                        <TextBlock Text="equilibrado" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock Text="limita a CPU" Foreground="{DynamicResource Faint}" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Name="BnBalanceText" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                    <TextBlock Text="Estimativa pelo desempenho relativo típico; o detector ao vivo mostra a realidade de cada jogo."
                                               Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Veredito ao vivo: invertido (fundo claro) quando o limite é um problema -->
                            <Border Name="BnLiveCard" Grid.Column="2" Classes="card">
                                <StackPanel>
                                    <TextBlock Name="BnLiveLabel" Text="AGORA" Classes="label"/>
                                    <TextBlock Name="BnLiveTitle" Text="—" FontSize="24" FontWeight="SemiBold"/>
                                    <TextBlock Name="BnLiveGame" Foreground="{DynamicResource Muted}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                                    <TextBlock Name="BnLiveAdvice" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Leituras ao vivo -->
                        <Border Classes="card" Margin="0,0,0,14" Padding="18,16,18,6">
                            <StackPanel>
                                <TextBlock Text="LEITURAS AO VIVO" Classes="label"/>
                                <ItemsControl Name="BnMeters" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <!-- Mesmo medidor do histórico, com espaço entre as colunas -->
                                        <DataTemplate x:DataType="local:MeterItem">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Meter}" Margin="0,0,24,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Sessão -->
                        <Border Classes="card">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="ANÁLISE DE SESSÃO" Classes="label"/>
                                        <TextBlock Text="Clique em iniciar, abra o jogo e jogue normalmente. Ao final você recebe o diagnóstico."
                                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <StackPanel Name="BnDurationPanel" Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="BnDur" Content="1 min" Tag="1" Margin="0,0,6,0" IsChecked="True"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="BnDur" Content="3 min" Tag="3" Margin="0,0,6,0"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="BnDur" Content="5 min" Tag="5" Margin="0"/>
                                        </StackPanel>
                                        <Button Name="BtnBnSession" Theme="{StaticResource PrimaryButton}" Content="INICIAR ANÁLISE" Click="BtnBnSession_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Name="BnSessionStatus" Foreground="{DynamicResource Muted}" Margin="0,14,0,0"/>
                                <StackPanel Name="BnResult" IsVisible="False" Margin="0,16,0,0">
                                    <TextBlock Name="BnResultTitle" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock Name="BnResultSummary" Foreground="{DynamicResource Muted}" Margin="0,4,0,14" TextWrapping="Wrap"/>
                                    <ItemsControl Name="BnDistribution" ItemTemplate="{StaticResource Meter}"/>
                                    <TextBlock Name="BnResultAdvice" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== RESET BENCH ===== -->
                <Grid Name="PageBench" Margin="36,30,36,30" RowDefinitions="Auto,Auto,*" IsVisible="False">
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="RESET BENCH" Classes="h1"/>
                        <TextBlock Name="BenchSub" Text="Benchmark de CPU por renderização 3D (path tracing), no mesmo princípio do Cinebench" Classes="sub"/>
                    </StackPanel>

                    <!-- Seletor de teste -->
                    <WrapPanel Name="BenchTestPanel" Grid.Row="1" Margin="0,0,0,16">
                        <RadioButton Theme="{StaticResource Chip}" GroupName="BenchTest" Content="Render (CPU)" Tag="render" IsChecked="True" IsCheckedChanged="BenchTest_Checked"/>
                        <RadioButton Theme="{StaticResource Chip}" GroupName="BenchTest" Content="Cena de jogo (GPU)" Tag="gpu" IsCheckedChanged="BenchTest_Checked"/>
                        <RadioButton Theme="{StaticResource Chip}" GroupName="BenchTest" Content="Ray tracing (GPU)" Tag="rt" IsCheckedChanged="BenchTest_Checked"/>
                        <RadioButton Theme="{StaticResource Chip}" GroupName="BenchTest" Content="Simulação de jogo (CPU)" Tag="sim" IsCheckedChanged="BenchTest_Checked"/>
                        <RadioButton Theme="{StaticResource Chip}" GroupName="BenchTest" Content="Memória e carregamento" Tag="mem" IsCheckedChanged="BenchTest_Checked"/>
                        <RadioButton Theme="{StaticResource Chip}" GroupName="BenchTest" Content="Disco" Tag="disk" IsCheckedChanged="BenchTest_Checked"/>
                    </WrapPanel>

                    <!-- ===== Render (CPU) ===== -->
                    <Grid Name="BenchPanelRender" Grid.Row="2" ColumnDefinitions="*,16,310">
                        <Border Classes="card" Padding="14" VerticalAlignment="Top">
                            <StackPanel>
                                <Border Background="#050505">
                                    <Viewbox Stretch="Uniform">
                                        <Panel Width="960" Height="540">
                                            <Image Name="BenchImage" Width="960" Height="540" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                            <Canvas Name="BenchBuckets" Width="960" Height="540"/>
                                            <TextBlock Name="BenchIdle" Text="Pressione INICIAR para renderizar a cena"
                                                       Foreground="{DynamicResource Faint}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Panel>
                                    </Viewbox>
                                </Border>
                                <ProgressBar Name="BenchProgress" Classes="bar" Margin="0,12,0,8"/>
                                <Grid>
                                    <TextBlock Name="BenchStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Name="BenchElapsed" Classes="mono" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="TESTE" Classes="label"/>
                                        <WrapPanel Name="BenchModePanel">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="BenchMode" Content="Multi-core" Tag="mt"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="BenchMode" Content="Single-core" Tag="st"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="BenchMode" Content="Ambos" Tag="both" IsChecked="True"/>
                                        </WrapPanel>
                                        <TextBlock Text="DURAÇÃO" Classes="label" Margin="0,10,0,8"/>
                                        <WrapPanel Name="BenchDurationPanel">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="BenchDur" Content="1 passada" Tag="0" IsChecked="True"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="BenchDur" Content="Mínimo 10 min" Tag="10"/>
                                        </WrapPanel>
                                        <Button Name="BtnBench" Theme="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch" Click="BtnBench_Click"/>
                                        <TextBlock Name="BenchHint" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Classes="label"/>
                                        <Grid>
                                            <TextBlock Text="Multi-core" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Name="BenchMt" Text="—" Classes="mono" FontSize="30"/>
                                                <TextBlock Text=" pts" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,6,0,0">
                                            <TextBlock Text="Single-core" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Name="BenchSt" Text="—" Classes="mono" FontSize="30"/>
                                                <TextBlock Text=" pts" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Name="BenchRatio" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="DURANTE O TESTE" Classes="label"/>
                                        <ItemsControl Name="BenchLive" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>

                                <Border Classes="card">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Classes="label"/>
                                        <TextBlock Name="BenchHistoryEmpty" Text="Nenhum resultado ainda." Foreground="{DynamicResource Faint}"/>
                                        <ItemsControl Name="BenchHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Cena de jogo (GPU) ===== -->
                    <Grid Name="BenchPanelGpu" Grid.Row="2" ColumnDefinitions="*,16,310" IsVisible="False">
                        <Border Classes="card" VerticalAlignment="Top" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="VALE · CENA DE JOGO" Classes="label"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                           Text="Sobrevoo de um vale com terreno gerado por ruído fractal (~500 mil triângulos), 40 mil árvores por instancing, sombras em tempo real (mapa 4096² com bordas suaves), água com ondas, neblina, céu e pós-processamento HDR. A câmera segue um trajeto fixo pelo tempo e a resolução é fixa: o trabalho é o mesmo em qualquer PC. A cena abre numa janela própria; ESC cancela."/>
                                <Grid Margin="0,22,0,0">
                                    <StackPanel>
                                        <TextBlock Text="FPS AGORA" Classes="label"/>
                                        <TextBlock Name="GbFpsNow" Text="—" Classes="mono" FontSize="44"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="GPU" Classes="label" HorizontalAlignment="Right"/>
                                        <TextBlock Name="GbGpuNow" Text="—" Classes="mono" FontSize="20" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Name="GbProgress" Classes="bar" Margin="0,14,0,8"/>
                                <TextBlock Name="GbStatus" Text="Pronto" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESOLUÇÃO" Classes="label"/>
                                        <WrapPanel Name="GbResPanel">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="GbRes" Content="1080p" Tag="1920x1080" IsChecked="True"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="GbRes" Content="1440p" Tag="2560x1440"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="GbRes" Content="4K" Tag="3840x2160"/>
                                        </WrapPanel>
                                        <TextBlock Text="DURAÇÃO" Classes="label" Margin="0,10,0,8"/>
                                        <WrapPanel Name="GbDurPanel">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="GbDur" Content="30 s" Tag="30"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="GbDur" Content="60 s" Tag="60" IsChecked="True"/>
                                        </WrapPanel>
                                        <Button Name="BtnGpuBench" Theme="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch" Click="BtnGpuBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Classes="label"/>
                                        <ItemsControl Name="GbResult" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Classes="label"/>
                                        <ItemsControl Name="GbHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Ray tracing (GPU, DXR 1.1) ===== -->
                    <Grid Name="BenchPanelRt" Grid.Row="2" ColumnDefinitions="*,16,310" IsVisible="False">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="card" VerticalAlignment="Top" Padding="24,20" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="CIDADE DE OBJETOS · RAY TRACING POR HARDWARE" Classes="label"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}"
                                                   Text="Direct3D 12 com DXR 1.1: usa os núcleos de ray tracing da placa (RTX 20 ou mais nova, Radeon RX 6000 ou mais nova, Intel Arc). 4 mil objetos em materiais fosco, metal e espelho; por pixel, path tracing com sombras suaves, oclusão de ambiente, reflexos de reflexos e iluminação indireta. A estrutura de aceleração é refeita a cada frame, com objetos girando, como nos jogos. Abre numa janela própria; ESC cancela."/>
                                        <Grid Margin="0,22,0,0">
                                            <StackPanel>
                                                <TextBlock Text="FPS AGORA" Classes="label"/>
                                                <TextBlock Name="RtFpsNow" Text="—" Classes="mono" FontSize="44"/>
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right">
                                                <TextBlock Text="ETAPA" Classes="label" HorizontalAlignment="Right"/>
                                                <TextBlock Name="RtPhase" Text="—" Classes="mono" FontSize="20" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                        <ProgressBar Name="RtProgress" Classes="bar" Margin="0,14,0,8"/>
                                        <TextBlock Name="RtStatus" Text="Pronto" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Padding="24,20">
                                    <StackPanel>
                                        <TextBlock Text="COMO COMPARAR COM CONFIANÇA" Classes="label"/>
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12"
                                                   Text="O teste aquece a placa sem medir (o clock e a temperatura se estabilizam) e depois roda 3 passadas iguais. A nota usa a MEDIANA das passadas, e a variação entre elas mostra se o resultado é confiável (abaixo de 3%). O tempo de cada frame vem do relógio da própria GPU. Compare só resultados com a mesma resolução e o mesmo preset, com o PC na tomada, sem outros programas pesados abertos e com o mesmo driver. A cena é sempre a mesma (sementes fixas), em qualquer PC."/>
                                        <TextBlock Text="REFERÊNCIA MEDIDA" Classes="label" Margin="0,14,0,4"/>
                                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                                   Text="AMD Radeon RX 9070 · Alta 1440p · modo Padrão: 878 pts (87,8 FPS, 1% low 77), variação 0,5%."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESOLUÇÃO" Classes="label"/>
                                        <WrapPanel Name="RtResPanel">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="RtRes" Content="1080p" Tag="1920x1080"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="RtRes" Content="1440p" Tag="2560x1440" IsChecked="True"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="RtRes" Content="4K" Tag="3840x2160"/>
                                        </WrapPanel>
                                        <TextBlock Text="PRESET" Classes="label" Margin="0,10,0,8"/>
                                        <WrapPanel Name="RtPresetPanel">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="RtPreset" Content="Normal" Tag="normal"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="RtPreset" Content="Alta" Tag="alta" IsChecked="True"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="RtPreset" Content="Extrema" Tag="extrema"/>
                                        </WrapPanel>
                                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Text="Normal: 2 amostras e 2 rebatidas por pixel · Alta: 4 e 3 · Extrema: 8 e 4."/>
                                        <TextBlock Text="MODO" Classes="label" Margin="0,10,0,8"/>
                                        <WrapPanel Name="RtModePanel">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="RtMode" Content="Padrão" Tag="std" IsChecked="True"
                                                         ToolTip.Tip="Aquece 20 s e mede 3 passadas de 30 s (~2 min). Use para comparar."/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="RtMode" Content="Rápido" Tag="quick"
                                                         ToolTip.Tip="Aquece 5 s e mede 3 passadas de 10 s (~35 s). Só para uma ideia rápida."/>
                                        </WrapPanel>
                                        <Button Name="BtnRtBench" Theme="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch" Click="BtnRtBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Classes="label"/>
                                        <TextBlock Name="RtVerdict" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <ItemsControl Name="RtResult" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Classes="label"/>
                                        <ItemsControl Name="RtHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Simulação de jogo (CPU) ===== -->
                    <Grid Name="BenchPanelSim" Grid.Row="2" ColumnDefinitions="*,16,310" IsVisible="False">
                        <Border Classes="card" Padding="14" VerticalAlignment="Top">
                            <StackPanel>
                                <Panel>
                                    <Border Background="#050505" HorizontalAlignment="Center">
                                        <Image Name="SimImage" Width="440" Height="440" RenderOptions.BitmapInterpolationMode="None"/>
                                    </Border>
                                    <TextBlock Name="SimIdle" Text="30 mil unidades em batalha" Foreground="{DynamicResource Faint}" FontSize="18"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Panel>
                                <ProgressBar Name="SimProgress" Classes="bar" Margin="0,12,0,8"/>
                                <Grid>
                                    <TextBlock Name="SimStatus" Text="Pronto" Foreground="{DynamicResource Muted}"/>
                                    <TextBlock Name="SimFpsNow" Classes="mono" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Text="Simula o trabalho de CPU de um jogo: a thread principal monta a grade espacial, roda a lógica e prepara o desenho; as outras threads calculam física, colisão e IA de 30 mil unidades. A nota é quantos frames por segundo a CPU aguenta."/>
                                        <TextBlock Text="DURAÇÃO" Classes="label"/>
                                        <WrapPanel Name="SimDurPanel">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="SimDur" Content="20 s" Tag="20" IsChecked="True"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="SimDur" Content="60 s" Tag="60"/>
                                        </WrapPanel>
                                        <Button Name="BtnSimBench" Theme="{StaticResource PrimaryButton}" Content="INICIAR" Margin="0,12,0,0"
                                                HorizontalAlignment="Stretch" Click="BtnSimBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="RESULTADO" Classes="label"/>
                                        <ItemsControl Name="SimResult" ItemTemplate="{StaticResource KeyValueRow}"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Classes="label"/>
                                        <ItemsControl Name="SimHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Memória e carregamento ===== -->
                    <Grid Name="BenchPanelMem" Grid.Row="2" ColumnDefinitions="*,16,310" IsVisible="False">
                        <Border Classes="card" VerticalAlignment="Top" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="RESULTADOS" Classes="label"/>
                                <ItemsControl Name="MemResult" Margin="0,4,0,0" ItemTemplate="{StaticResource MemRowTemplate}"/>
                                <ProgressBar Name="MemProgress" Classes="bar" Margin="0,16,0,8"/>
                                <TextBlock Name="MemStatus" Text="Pronto" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                                                   Text="Mede a latência e a banda da RAM e simula o carregamento de um mapa: um pacote de 512 MB e mil arquivos de 64 KB, lidos do disco sem o cache do sistema. Os arquivos de teste ficam na pasta temporária e são apagados no final."/>
                                        <Button Name="BtnMemBench" Theme="{StaticResource PrimaryButton}" Content="INICIAR"
                                                HorizontalAlignment="Stretch" Click="BtnMemBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Classes="label"/>
                                        <ItemsControl Name="MemHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Disco ===== -->
                    <Grid Name="BenchPanelDisk" Grid.Row="2" ColumnDefinitions="*,16,310" IsVisible="False">
                        <Border Classes="card" VerticalAlignment="Top" Padding="24,20">
                            <StackPanel>
                                <TextBlock Text="RESULTADOS" Classes="label"/>
                                <ItemsControl Name="DiskResult" Margin="0,4,0,0" ItemTemplate="{StaticResource MemRowTemplate}"/>
                                <ProgressBar Name="DiskProgress" Classes="bar" Margin="0,16,0,8"/>
                                <TextBlock Name="DiskStatus" Text="Pronto" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Classes="card" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="UNIDADE" Classes="label"/>
                                        <WrapPanel Name="DiskDrivePanel"/>
                                        <TextBlock Text="TAMANHO DO TESTE" Classes="label" Margin="0,10,0,8"/>
                                        <WrapPanel Name="DiskSizePanel">
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="DiskSize" Content="512 MB" Tag="512"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="DiskSize" Content="1 GB" Tag="1024" IsChecked="True"/>
                                            <RadioButton Theme="{StaticResource Chip}" GroupName="DiskSize" Content="4 GB" Tag="4096"/>
                                        </WrapPanel>
                                        <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,12"
                                                   Text="Mede leitura e escrita sequenciais e acessos aleatórios de 4 KB, direto no disco (sem o cache do sistema). Grava um arquivo temporário na unidade escolhida e o apaga no final. Feche outros programas pesados antes."/>
                                        <Button Name="BtnDiskBench" Theme="{StaticResource PrimaryButton}" Content="INICIAR"
                                                HorizontalAlignment="Stretch" Click="BtnDiskBench_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card">
                                    <StackPanel>
                                        <TextBlock Text="HISTÓRICO" Classes="label"/>
                                        <ItemsControl Name="DiskHistory" ItemTemplate="{StaticResource Meter}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ===== PLACA DE VÍDEO ===== -->
                <Grid Name="PageGpu" Margin="36,30,36,30" RowDefinitions="Auto,Auto,*" IsVisible="False">
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Placa de vídeo" Classes="h1"/>
                            <TextBlock Text="Especificações completas e sensores em tempo real" Classes="sub"/>
                        </StackPanel>
                        <WrapPanel Name="GpuChips" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    </Grid>

                    <!-- Destaque -->
                    <Border Grid.Row="1" Classes="card" Margin="0,0,0,14" Padding="24,20">
                        <Grid>
                            <StackPanel Margin="0,0,180,0">
                                <TextBlock Name="GpuName" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Name="GpuSubtitle" Foreground="{DynamicResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Name="GpuVendor" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="30" FontWeight="Black" Foreground="{DynamicResource Faint}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="*,16,330">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                            <ItemsControl Name="GpuSections">
                                <ItemsControl.ItemTemplate>
                                    <!-- Seção em cartão com 3 colunas de campos (rótulo em cima, valor embaixo) -->
                                    <DataTemplate x:DataType="core:InfoNode">
                                        <Border Classes="card" Margin="0,0,0,14" Padding="20,16,20,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Header}" Classes="label" Margin="0,0,0,2"/>
                                                <ItemsControl ItemsSource="{Binding Children}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="core:InfoNode">
                                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,10,18,10">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Header}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                                                    <TextBlock Text="{Binding Value}" FontSize="14" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Sensores (equivalente à aba Sensors do GPU-Z) -->
                        <Border Grid.Column="2" Classes="card" Padding="20,16,12,12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="SENSORES AO VIVO" Classes="label" Margin="0,0,0,6"/>
                                <ItemsControl Name="GpuExtras" DockPanel.Dock="Top" Margin="0,0,8,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <Grid Margin="0,5">
                                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Muted}"/>
                                                <TextBlock Text="{Binding Value}" Classes="mono" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="GpuLive" Margin="0,0,8,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:SensorRow">
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,6">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                                            <Run Text="{Binding Category, Mode=OneWay}" Foreground="{DynamicResource Faint}"/>
                                                            <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== SENSORES ===== -->
                <Grid Name="PageSensors" Margin="36,30,36,30" RowDefinitions="Auto,Auto,*" IsVisible="False">
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Sensores" Classes="h1"/>
                            <TextBlock Name="StatusText" Text="Lendo sensores…" Classes="sub"/>
                        </StackPanel>
                        <TextBox Name="SensorSearch" Width="260" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 PlaceholderText="Buscar sensor ou hardware…" TextChanged="SensorSearch_Changed"/>
                    </Grid>
                    <WrapPanel Name="CategoryChips" Grid.Row="1" Margin="0,0,0,14"/>
                    <Border Grid.Row="2" Classes="card" Padding="6,14,6,6">
                        <Grid RowDefinitions="Auto,*">
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,0,12,10">
                                <Grid ColumnDefinitions="*,130,130,120,120">
                                    <TextBlock Text="SENSOR" Classes="colHeader"/>
                                    <TextBlock Grid.Column="1" Text="TIPO" Classes="colHeader"/>
                                    <TextBlock Grid.Column="2" Text="VALOR" Classes="colHeader"/>
                                    <TextBlock Grid.Column="3" Text="MÍN." Classes="colHeader"/>
                                    <TextBlock Grid.Column="4" Text="MÁX." Classes="colHeader"/>
                                </Grid>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Name="SensorGroups">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:SensorGroup">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="12,22,0,8"/>
                                                <ItemsControl ItemsSource="{Binding Rows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="core:SensorRow">
                                                            <Border Classes="sensorRow" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                                                    MinHeight="32" Padding="12,0">
                                                                <Grid ColumnDefinitions="*,130,130,120,120" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{DynamicResource Muted}"/>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Value}" Classes="mono"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding Min}" Classes="mono" Foreground="{DynamicResource Muted}"/>
                                                                    <TextBlock Grid.Column="4" Text="{Binding Max}" Classes="mono" Foreground="{DynamicResource Muted}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== SISTEMA ===== -->
                <Grid Name="PageSystem" Margin="36,30,36,30" RowDefinitions="Auto,*" IsVisible="False">
                    <Grid Margin="0,0,0,24">
                        <StackPanel Margin="0,0,200,0">
                            <TextBlock Text="Sistema" Classes="h1"/>
                            <TextBlock Name="SystemSub" Text="Hardware e software detectados" Classes="sub" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Name="BtnReport" Theme="{StaticResource OutlineButton}" Content="EXPORTAR RELATÓRIO" Padding="16,9"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnReport_Click"
                                ToolTip.Tip="Salva um relatório (HTML ou JSON) com sistema, RAM, discos, GPU, sensores e benchmarks. Números de série são omitidos."/>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="220,24,*">
                        <ListBox Name="InfoCategories" ItemContainerTheme="{StaticResource ListNavItem}" Background="Transparent"
                                 SelectionChanged="InfoCategories_Changed">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="core:InfoNode">
                                    <TextBlock Text="{Binding Header}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Grid.Column="2" Classes="card" Padding="26,8,26,22">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Name="InfoTitle" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,8"/>

                                    <!-- Unidades (só em Armazenamento): anel de cheio/vazio por letra -->
                                    <StackPanel Name="DrivesPanel" IsVisible="False" Margin="0,4,0,8">
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock Text="UNIDADES" Classes="label" Margin="0"/>
                                            <TextBlock Name="DrivesSummary" Foreground="{DynamicResource Muted}" FontSize="12" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ItemsControl Name="DriveCards">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="plat:DriveCard">
                                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" Padding="16,14" Margin="0,0,10,10"
                                                            Background="{DynamicResource Bg}">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <!-- Anel: trilha cinza = vazio, arco branco = usado -->
                                                            <Grid Width="84" Height="84" Margin="0,0,16,0" VerticalAlignment="Center">
                                                                <Ellipse Width="72" Height="72" Stroke="{DynamicResource Line}" StrokeThickness="8"/>
                                                                <Path Data="{Binding UsedFraction, Converter={StaticResource UsedArc}}" Stroke="{DynamicResource Fg}"
                                                                      StrokeThickness="8" StrokeLineCap="Flat"/>
                                                                <TextBlock Text="{Binding UsedPercent}" Classes="mono" FontSize="15"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Sizes}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="DISCOS FÍSICOS" Classes="label" Margin="0,14,0,0"/>
                                    </StackPanel>

                                    <ItemsControl Name="InfoDetails"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== DISCOS (saúde) ===== -->
                <ScrollViewer Name="PageDisks" IsVisible="False" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Discos" Classes="h1"/>
                                <TextBlock Name="DiskHealthStatus" Text="Saúde, desgaste e temperatura de cada disco" Classes="sub" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Name="BtnDiskRefresh" Theme="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="18,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnDiskRefresh_Click"/>
                        </Grid>
                        <ItemsControl Name="DiskCards" ItemTemplate="{StaticResource HealthCard}"/>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"
                                   Text="Os dados vêm do sistema (S.M.A.R.T. e API de armazenamento) e dos sensores do disco. Pendrives e alguns HDs externos não informam saúde. O veredito é uma estimativa: faça backup de qualquer disco com aviso, não só dos críticos."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== ENERGIA (bateria e fonte) ===== -->
                <ScrollViewer Name="PageEnergy" IsVisible="False" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Energia" Classes="h1"/>
                                <TextBlock Name="EnergyStatus" Text="Bateria, fonte de energia e consumo" Classes="sub" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Name="BtnEnergyRefresh" Theme="{StaticResource OutlineButton}" Content="ATUALIZAR" Padding="18,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnEnergyRefresh_Click"/>
                        </Grid>
                        <ItemsControl Name="EnergyCards" ItemTemplate="{StaticResource HealthCard}"/>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"
                                   Text="Os dados vêm do sistema. Alguns notebooks não informam ciclos de carga ou a capacidade de projeto. O consumo mostrado vem dos sensores de CPU e GPU, não da fonte (PSU) do PC."/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== REDE (diagnóstico de lag) ===== -->
                <ScrollViewer Name="PageNet" IsVisible="False" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="36,30,36,30">
                        <Grid Margin="0,0,0,20">
                            <StackPanel Margin="0,0,160,0">
                                <TextBlock Text="Rede" Classes="h1"/>
                                <TextBlock Text="Descubra se o lag vem do seu PC, do Wi-Fi ou do provedor" Classes="sub" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Name="BtnNetTest" Theme="{StaticResource PrimaryButton}" Content="TESTAR" Padding="22,9"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnNetTest_Click"/>
                        </Grid>
                        <ProgressBar Name="NetProgress" Classes="bar" Margin="0,0,0,8"/>
                        <TextBlock Name="NetStatus" Text="Pronto. O teste leva cerca de 30 segundos." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <ItemsControl Name="NetCards" ItemTemplate="{StaticResource HealthCard}"/>
                        <TextBlock Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap"
                                   Text="O teste envia pacotes de ping ao roteador e aos DNS públicos 1.1.1.1 e 8.8.8.8 e baixa/envia dados de teste do servidor público speed.cloudflare.com (cerca de 100 MB no total). Feche downloads, streaming e jogos antes para um resultado fiel."/>
                    </StackPanel>
                </ScrollViewer>

            </Panel>
        </Grid>
    </Border>
</Window>
