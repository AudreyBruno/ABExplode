<Window x:Class="ResetExplode.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RESET EXPLODE overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" Focusable="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border x:Name="Box" Background="#C8000000" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4" Padding="12,9">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Border.LayoutTransform>
        <StackPanel TextElement.FontFamily="Cascadia Mono, Consolas" TextElement.FontSize="12" TextElement.Foreground="#F5F5F5">
            <!-- FPS em destaque -->
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="OFps" Text="—" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text=" FPS" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                <TextBlock x:Name="OFrameTime" Text="" Foreground="#8C8C8C" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
            </StackPanel>
            <TextBlock x:Name="OLow" Text="1% low —" Foreground="#8C8C8C"/>
            <!-- Gráfico de frametime -->
            <Canvas x:Name="OGraph" Width="190" Height="30" Margin="0,6,0,4" ClipToBounds="True"/>
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="GPU" Foreground="#8C8C8C"/>
                <TextBlock x:Name="OGpu" Grid.Column="1" Text="—"/>
                <TextBlock Grid.Row="1" Text="CPU" Foreground="#8C8C8C"/>
                <TextBlock x:Name="OCpu" Grid.Row="1" Grid.Column="1" Text="—"/>
                <TextBlock Grid.Row="2" Text="RAM" Foreground="#8C8C8C"/>
                <TextBlock x:Name="ORam" Grid.Row="2" Grid.Column="1" Text="—"/>
            </Grid>
            <TextBlock x:Name="OGame" Text="" Foreground="#5A5A5A" FontSize="10" Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</Window>
